# Gemini API key. Required for /api/advice and /api/ask. Set it in Vercel, never in the repo.
GEMINI_API_KEY=

# Primary Gemini model. Defaults to gemini-3.8-flash when empty.
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated fallback model ids (max 3), tried in order. Defaults to gemini-3.6-flash when empty.
GEMINI_FALLBACK_MODELS=
